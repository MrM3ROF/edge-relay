# Copy this file to config/relay.env and replace the placeholders.
# config/relay.env is intentionally ignored by Git.

# Public address assigned to the Linux gateway.
OCI_PUBLIC_IP=203.0.113.10

# Interface that owns the VM's private/publicly mapped address. Leave empty to
# detect it from the default IPv4 route on Linux.
PUBLIC_INTERFACE=

WIREGUARD_INTERFACE=wg0
WIREGUARD_PORT=51820
WIREGUARD_SERVER_IP=10.77.0.1
WIREGUARD_CLIENT_IP=10.77.0.2
WIREGUARD_MTU=1380

# Public keys are safe to place in this ignored local configuration file.
WIREGUARD_SERVER_PUBLIC_KEY=REPLACE_WITH_LINUX_PUBLIC_KEY
WINDOWS_PUBLIC_KEY=REPLACE_WITH_WINDOWS_PUBLIC_KEY

# Address of the Windows server on its LAN. This must match service targets
# hosted by that Windows machine.
HOME_SERVER_IP=192.168.1.50

# Optional documentation value. The setup scripts do not modify Tailscale.
HOME_TAILSCALE_IP=100.64.0.10
